"""Rust の束ね（globe-mode-py）の型。入出力は JSON の文字列で、`globe_mode/__init__.py` が dict にする。

誤りは `globe_mode/_errors.py` の例外で出る（`LibraryError` など）。"""

import os
from collections.abc import Callable, Iterable
from pathlib import Path
from typing import Any

class Workspace:
    def __init__(self, libraries: Iterable[str | os.PathLike[str]] = ...) -> None: ...
    def set_file(self, path: str, text: str) -> None: ...
    def load_dir(self, dir: str | os.PathLike[str]) -> int: ...
    def check(self, model: str) -> str: ...
    def graph(self, model: str, depth: int = 1) -> str: ...
    def outline(self, path: str) -> str: ...
    def deps(self, model: str) -> str: ...
    def flat(self, model: str) -> str: ...
    def blt(self, model: str) -> str: ...
    def linearize(self, model: str, time: float | None = None, overrides: str | None = None) -> str: ...
    def simulate(self, model: str, settings: str | None = None, on_progress: Callable[[Any], Any] | None = None) -> str: ...
    def simulate_columns(
        self, model: str, settings: str | None = None, on_progress: Callable[[Any], Any] | None = None
    ) -> tuple[str, list[str], list[bytes]]: ...
    def export_fmu(self, model: str, out_dir: str | os.PathLike[str], options: str | None = None) -> Path: ...

def solvers() -> str: ...
def settings_sample() -> str: ...
def format(text: str, indent: int = 2, insert_origin: bool = True) -> str: ...
def lint(text: str) -> str: ...
def read_results(path: str | os.PathLike[str]) -> tuple[str, list[str], list[bytes]]: ...
def fmu_info(path: str | os.PathLike[str]) -> str: ...
def run_fmu(
    worker: str | os.PathLike[str],
    path: str | os.PathLike[str],
    request: str | None = None,
    on_progress: Callable[[float], Any] | None = None,
) -> tuple[str, list[str], list[bytes]]: ...
def cosim(
    worker: str | os.PathLike[str],
    spec: str | None = None,
    ssp: str | os.PathLike[str] | None = None,
    stop_time: float | None = None,
    step: float | None = None,
    on_progress: Callable[[float], Any] | None = None,
) -> tuple[str, list[str], list[bytes]]: ...
