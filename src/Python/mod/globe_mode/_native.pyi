"""Rust の束ね（globe-mode-py）の型。入出力は JSON の文字列で、`globe_mode/__init__.py` が dict にする。"""

import os
from collections.abc import Callable
from typing import Any

class Workspace:
    def __init__(self, libraries: list[str] = ...) -> None: ...
    def set_file(self, path: str, text: str) -> None: ...
    def load_dir(self, dir: str | os.PathLike[str]) -> int: ...
    def check(self, model: str) -> str: ...
    def graph(self, model: str, depth: int = 1) -> str: ...
    def outline(self, path: str) -> str: ...
    def deps(self, model: str) -> str: ...
    def flat(self, model: str) -> str: ...
    def simulate(self, model: str, settings: str | None = None, on_progress: Callable[[Any], Any] | None = None) -> str: ...
    def simulate_columns(
        self, model: str, settings: str | None = None, on_progress: Callable[[Any], Any] | None = None
    ) -> tuple[str, list[str], list[bytes]]: ...
    def export_fmu(self, model: str, out_dir: str | os.PathLike[str], options: str | None = None) -> str: ...

def solvers() -> str: ...
def settings_sample() -> str: ...
def format(text: str, indent: int = 2, insert_origin: bool = True) -> str: ...
def lint(text: str) -> str: ...
