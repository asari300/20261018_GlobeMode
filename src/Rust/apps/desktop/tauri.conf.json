{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GlobeMode",
  "version": "0.0.1",
  "identifier": "io.github.asari300.globemode",
  "build": {
    "frontendDist": "../../../Svelte/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "title": "GlobeMode", "width": 1280, "height": 800 }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "msi"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "externalBin": ["binaries/globe"],
    "publisher": "GlobeMode",
    "copyright": "MIT OR Apache-2.0",
    "category": "DeveloperTool",
    "shortDescription": "Modelica IDE",
    "longDescription": "GlobeMode: an open-source Modelica IDE. Checking and simulation run in the bundled `globe` sidecar process."
  }
}
